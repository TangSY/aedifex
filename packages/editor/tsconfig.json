{
  "extends": "@pascal/typescript-config/react-library.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["bun"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/**/__tests__", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
