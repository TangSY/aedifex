{
  "name": "@aedifex/nodes",
  "version": "0.2.0",
  "description": "Built-in node bundles for the Aedifex 3D editor \u2014 one folder per kind, exported as `builtinPlugin`",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./procedural-item": {
      "types": "./dist/procedural-item/index.d.ts",
      "import": "./dist/procedural-item/index.js",
      "default": "./dist/procedural-item/index.js"
    },
    "./agent-tools": {
      "types": "./dist/agent-tools/index.d.ts",
      "import": "./dist/agent-tools/index.js",
      "default": "./dist/agent-tools/index.js"
    },
    "./agent-operations": {
      "types": "./dist/agent-operations/index.d.ts",
      "import": "./dist/agent-operations/index.js",
      "default": "./dist/agent-operations/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=6144 tsc --build && bun ../../scripts/fix-node-esm-imports.ts dist",
    "dev": "tsgo --build --watch",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test"
  },
  "peerDependencies": {
    "@aedifex/core": "^0.10.0",
    "@aedifex/editor": "^0.9.2",
    "@aedifex/viewer": "^0.10.0",
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "lucide-react": "^1",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "three": "^0.186",
    "zustand": "^5"
  },
  "devDependencies": {
    "@aedifex/core": "^0.10.0",
    "@aedifex/editor": "^0.9.2",
    "@aedifex/viewer": "^0.10.0",
    "@repo/typescript-config": "*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@react-three/test-renderer": "^9.1.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "7.0.2",
    "@aedifex/mcp": "workspace:*"
  },
  "keywords": [
    "aedifex",
    "3d",
    "editor",
    "node-registry"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TangSY/aedifex.git",
    "directory": "packages/nodes"
  },
  "license": "MIT",
  "homepage": "https://github.com/TangSY/aedifex/tree/main/packages/nodes#readme",
  "bugs": "https://github.com/TangSY/aedifex/issues"
}
