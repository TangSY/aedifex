{
  "name": "@aedifex/mcp",
  "version": "0.3.3",
  "description": "Model Context Protocol server for Aedifex 3D editor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./storage/types": {
      "types": "./dist/storage/types.d.ts",
      "import": "./dist/storage/types.js",
      "default": "./dist/storage/types.js"
    },
    "./operations": {
      "types": "./dist/operations/index.d.ts",
      "import": "./dist/operations/index.js",
      "default": "./dist/operations/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js",
      "default": "./dist/bridge/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.js",
      "default": "./dist/templates/index.js"
    }
  },
  "bin": {
    "aedifex-mcp": "./dist/bin/aedifex-mcp.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsgo --build --watch",
    "start": "bun dist/bin/aedifex-mcp.js",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "prepublishOnly": "bun run build && bun test"
  },
  "peerDependencies": {
    "@aedifex/core": "^0.10.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@aedifex/lingo": "npm:@pascal-app/lingo@^0.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@aedifex/core": "^0.10.0",
    "@repo/typescript-config": "*",
    "@types/node": "^22.19.20",
    "typescript": "6.0.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aedifex",
    "3d",
    "building",
    "editor",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TangSY/aedifex.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "homepage": "https://github.com/TangSY/aedifex/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/TangSY/aedifex/issues"
}
