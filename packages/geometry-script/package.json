{
  "name": "@aedifex/geometry-script",
  "version": "1.0.3",
  "description": "Compiles AI-authored three.js geometry scripts into GLB artifacts with an Aedifex manifest. Runs in a browser worker, Bun or Node \u2014 no DOM, no React.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compile": {
      "types": "./dist/compile.d.ts",
      "import": "./dist/compile.js",
      "default": "./dist/compile.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "import": "./dist/sandbox.js",
      "default": "./dist/sandbox.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build && bun ../../scripts/fix-node-esm-imports.ts dist && bun scripts/build-sandbox.ts",
    "dev": "tsgo --build --watch",
    "check-types": "tsgo --noEmit",
    "prepublishOnly": "npm run build",
    "test": "bun test"
  },
  "dependencies": {
    "three-bvh-csg": "^0.0.18"
  },
  "peerDependencies": {
    "three": "^0.186",
    "@aedifex/core": "^0.10.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "@types/three": "^0.184.0",
    "typescript": "6.0.3",
    "@aedifex/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TangSY/aedifex.git",
    "directory": "packages/geometry-script"
  },
  "license": "MIT",
  "homepage": "https://github.com/TangSY/aedifex/tree/main/packages/geometry-script#readme",
  "bugs": "https://github.com/TangSY/aedifex/issues"
}
