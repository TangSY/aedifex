{
  "name": "@aedifex/ifc-converter",
  "version": "0.1.3",
  "description": "IFC to Aedifex scene-graph conversion. Pure logic — no DOM, no React.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js",
      "default": "./dist/export/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/copy-web-ifc-wasm.mjs",
    "!dist/__bench__",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "check-types": "tsc -p tsconfig.bench.json --pretty false",
    "dev": "tsgo --build --watch",
    "test": "bun test tests",
    "bench:normals": "bun run src/__bench__/normal-recompute.bench.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "web-ifc": "^0.0.78"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/bun": "^1.4.4",
    "typescript": "7.0.2",
    "@aedifex/core": "workspace:*"
  },
  "peerDependencies": {
    "@aedifex/core": "^0.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TangSY/aedifex.git",
    "directory": "packages/ifc-converter"
  },
  "license": "MIT",
  "homepage": "https://github.com/TangSY/aedifex/tree/main/packages/ifc-converter#readme",
  "bugs": "https://github.com/TangSY/aedifex/issues"
}
