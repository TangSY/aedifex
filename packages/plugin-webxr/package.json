      "default": "./src/integrations/aedifex-editor/host/build-tab-state.ts"
    },
    "./host/webxr-wand-bindings": {
      "types": "./src/integrations/aedifex-editor/host/webxr-wand-bindings.ts",
      "default": "./src/integrations/aedifex-editor/host/webxr-wand-bindings.ts"
    },
    "./host/webxr-feature-gate": {
