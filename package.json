{
  "name": "editor",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e ./.env -e ./.env.defaults -- turbo run dev --env-mode=loose",
    "lint": "biome lint",
    "lints": "bun run lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "checks": "bun run check && bun run check-types",
    "check:fix": "biome check --write",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "ci": "bun run check && bun run check-types && bun run test && bun run build",
    "kill": "lsof -ti:3002 | xargs kill -9 2>/dev/null || echo 'No processes found on port 3002'",
    "clean:cache": "rm -rf apps/*/.next apps/*/.swc apps/*/.turbo packages/*/.turbo tooling/*/.turbo .turbo node_modules/.cache",
    "restart": "bun kill && bun clean:cache && bun dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@typescript/native-preview": "7.0.0-dev.20260624.1",
    "dotenv-cli": "^11.0.0",
    "fast-xml-parser": "^5.11.2",
    "turbo": "^2.11.9",
    "typescript": "6.0.3",
    "ultracite": "^8.0.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "next": "16.4.2",
    "react-grab": "0.2.0",
    "three": "0.186.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@react-three/fiber": "9.8.2"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-darwin-x64": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-darwin-x64": "1.32.0",
    "lightningcss-linux-arm64-gnu": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "patchedDependencies": {
    "iwer@2.3.0": "patches/iwer@2.3.0.patch",
    "three@0.186.1": "patches/three@0.186.1.patch",
    "three-bvh-csg@0.0.18": "patches/three-bvh-csg@0.0.18.patch"
  }
}
